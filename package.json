{
  "name": "oficina-billing",
  "version": "1.0.0",
  "description": "Orçamento e Pagamento — orçamentos, aprovação do cliente e cobrança pelo Mercado Pago",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "openapi:export": "tsx scripts/export-openapi.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^4.0.1",
    "amqplib": "^2.3.1",
    "dotenv": "^17.4.2",
    "fastify": "^4.28.1",
    "fastify-type-provider-zod": "^2.0.0",
    "mongodb": "^7.8.0",
    "newrelic": "^12.25.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/newrelic": "^9.14.8",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^2.1.8",
    "prettier": "^3.9.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
